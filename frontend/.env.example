# Copy to frontend/.env.

# The Django API. "/api" is appended if missing; unset, it is
# http://127.0.0.1:8000/api.
VITE_API_URL=http://127.0.0.1:8000

# Stripe publishable test key — the same account as STRIPE_SECRET_KEY in
# backend/.env. Without it the checkout page can't show the card form.
VITE_STRIPE_PUBLIC_KEY=
