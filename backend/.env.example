# Copy to backend/.env. The uncommented values run the API locally against
# the docker-compose Postgres. Everything commented out has a working default
# in config/settings.py.
#
# Leave a variable commented rather than blank: python-decouple reads
# `KEY=` as an empty string, not as unset, and an empty number or price
# stops the server at startup.

# ------------------------------------------------------------
# Core
# ------------------------------------------------------------
# Required, no default. Any long random string locally, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Off by default; when off, every request is redirected to HTTPS.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# LOG_LEVEL=INFO

# ------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# EXTRA_CORS_ORIGINS=http://127.0.0.1:5173
# CORS_ALLOW_CREDENTIALS=False

# ------------------------------------------------------------
# Database — docker-compose's `db` service (`docker compose up -d db`)
# ------------------------------------------------------------
DB_NAME=candles_db
DB_USER=candles_user
DB_PASSWORD=candles_pass
DB_HOST=127.0.0.1
DB_PORT=5433
# DB_CONN_MAX_AGE=60
# On a host that provides one, DATABASE_URL replaces the DB_* values above
# (and requires SSL).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ------------------------------------------------------------
# Auth tokens
# ------------------------------------------------------------
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------
# Stripe — test-mode keys from Dashboard > Developers > API keys
# ------------------------------------------------------------
# The publishable key goes in frontend/.env as VITE_STRIPE_PUBLIC_KEY.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# The webhook endpoint (/api/orders/webhook/) refuses every event while this
# is blank. Locally: `stripe listen --forward-to localhost:8000/api/orders/webhook/`
# prints one.
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Shippo — a test token from Settings > API. Without one, checkout charges
# SHIPPING_FALLBACK_RATE instead of a live rate.
# ------------------------------------------------------------
SHIPPO_TOKEN=
# SHIPPO_API_BASE=https://api.goshippo.com
# SHIPPO_API_VERSION=2018-02-08
# SHIPPO_TIMEOUT_SECONDS=30
# SHIPPO_LABEL_FILE_TYPE=PDF
# SHIPPO_MAX_RATES_PER_CARRIER=2
# SHIPPO_FALLBACK_PHONE=
# SHIPPING_FALLBACK_RATE=15.00

# The address parcels ship from; needed for live rates.
# SHIP_FROM_NAME=KFursenko Candles
# SHIP_FROM_COMPANY=
# SHIP_FROM_STREET1=
# SHIP_FROM_STREET2=
# SHIP_FROM_CITY=
# SHIP_FROM_STATE=
# SHIP_FROM_ZIP=
# SHIP_FROM_COUNTRY=US
# SHIP_FROM_PHONE=
# SHIP_FROM_EMAIL=

# ------------------------------------------------------------
# Lumière assistant (OpenAI). Without a key it answers with an apology and
# AI search falls back to plain catalogue matching.
# ------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=20

# ------------------------------------------------------------
# Media — product images are stored on Cloudinary.
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# ------------------------------------------------------------
# CLOUDINARY_URL=

# ------------------------------------------------------------
# Email. With DEBUG off and no SMTP credentials, mail goes to the console.
# ------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=no-reply@example.com
# SUPPORT_EMAIL=support@example.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10

# ------------------------------------------------------------
# Rate limits (DRF rate strings)
# ------------------------------------------------------------
# THROTTLE_ANON=60/min
# THROTTLE_USER=300/min
# THROTTLE_ORDERS_CREATE=10/min
# THROTTLE_STRIPE_INTENT_ANON=5/min
# THROTTLE_STRIPE_INTENT_USER=20/min
# THROTTLE_LUMIERE_ANON=20/min
# THROTTLE_LUMIERE_USER=60/min
# THROTTLE_LUMIERE_SEARCH=30/min
# THROTTLE_SHIPPING_RATES=20/min

# ------------------------------------------------------------
# Production only
# ------------------------------------------------------------
# SECURE_HSTS_SECONDS=3600
